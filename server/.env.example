# 복사해서 사용: cp .env.example .env

# API 주소 (DNS가 이 서버 공인 IP를 가리켜야 HTTPS 인증서 발급이 된다). Caddy를 쓸 때만 필요
API_DOMAIN=bittrack.duckdns.org

# DB 비밀번호: openssl rand -hex 24 로 만든 값 (URL에 들어가므로 영문·숫자만)
POSTGRES_PASSWORD=

# 아래는 선택 (기본값)
# RETENTION_DAYS=180            # 이보다 오래된 기록은 매시간 삭제
# MIN_WHALE_BTC=0.1             # 이 이상 거래만 저장
# FUTURES_SYMBOLS=BTCUSDT,ETHUSDT
# FUTURES_INTERVAL_SEC=300
# KIMCHI_INTERVAL_SEC=60
# CORS_ORIGIN=*                 # 특정 사이트만 허용하려면 https://your-site.vercel.app
